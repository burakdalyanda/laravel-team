{
    "name": "burakdalyanda/laravel-team",
    "description": "Laravel-native team membership and hierarchical team management.",
    "keywords": [
        "access control",
        "laravel",
        "team",
        "team management"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Burak Dalyanda",
            "email": "burak.dalyanda@hotmail.com",
            "homepage": "https://github.com/burakdalyanda",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/burakdalyanda/laravel-team",
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^2.9|^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "BurakDalyanda\\TeamGuard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BurakDalyanda\\TeamGuard\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.x-dev"
        },
        "laravel": {
            "providers": [
                "BurakDalyanda\\TeamGuard\\TeamGuardServiceProvider"
            ]
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "format:check": "pint --test",
        "test": "phpunit",
        "verify": [
            "@validate",
            "@format:check",
            "@analyse",
            "@test"
        ],
        "validate": "composer validate --strict"
    }
}
